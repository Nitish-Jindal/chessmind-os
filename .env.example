# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+asyncpg://chessmind:chessmind@localhost:5432/chessmind
# Optional: Alembic URL. Leave unset to derive it from DATABASE_URL (psycopg).
# DATABASE_URL_SYNC=postgresql+psycopg://chessmind:chessmind@localhost:5432/chessmind
JWT_SECRET=change-me-please
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14
STOCKFISH_PATH=../engines/stockfish-bin
STOCKFISH_DEFAULT_DEPTH=18
STOCKFISH_DEFAULT_MULTIPV=3
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional extra allowed-origin regex (Render static site host).
CORS_ORIGIN_REGEX=

# Optional LLM wording of coaching (off by default). Needs a provider API key and a model id.
# Moves, evaluations and statistics never come from the LLM; replies that cite anything outside
# the Stockfish/python-chess evidence are rejected and the deterministic template is used.
LLM_EXPLANATIONS_ENABLED=false
# xai (Grok) | openai | anthropic | gemini
LLM_PROVIDER=xai
LLM_API_KEY=
# Provider model id, e.g. a Grok, GPT, Claude or Gemini model name. Required when enabled.
LLM_MODEL=
# Optional API base URL override (OpenAI-compatible gateways).
LLM_BASE_URL=
LLM_TIMEOUT_S=6
